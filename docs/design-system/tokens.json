    "typography": {
        "font-sans": "'Manrope Variable', Manrope, ui-sans-serif, system-ui, sans-serif",
        "font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
        "scale": {
            "micro": { "size": "11px", "use": "подписи осей графиков" },
            "xs": { "size": "0.75rem", "lineHeight": "1rem", "use": "мета, подсказки, бейджи, заголовки таблиц" },
            "sm": { "size": "0.875rem", "lineHeight": "1.25rem", "use": "основной текст интерфейса" },
            "base": { "size": "1rem", "lineHeight": "1.5rem", "use": "поля ввода на мобильных, h3 в markdown" },
            "lg": { "size": "1.125rem", "use": "заголовок диалога, логотип в сайдбаре" },
            "xl": { "size": "1.25rem", "use": "заголовок страницы (Heading)" },
            "2xl": { "size": "1.5rem", "use": "цифры KPI-плиток" }
        },
        "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
    },
    "radius": {
        "base": "0.75rem",
        "sm": "calc(0.75rem - 4px)",
        "md": "calc(0.75rem - 2px)",
        "lg": "0.75rem",
        "xl": "calc(0.75rem + 4px)",
        "full": "9999px"
    },
    "layout": {
        "sidebar-width": "16rem",
        "sidebar-width-mobile": "18rem",
        "sidebar-width-icon": "3rem",
        "sidebar-shortcut": "Ctrl/Cmd+B",
        "header-height": "4rem (3rem при свёрнутом сайдбаре)",
        "page-padding": "1rem",
        "page-gap": "1.5rem",
        "grid-gap": "0.75rem–1rem",
        "settings-nav-width": "12rem",
        "settings-content-max": "36rem",
        "auth-column": "24rem"
    },
    "controls": {
        "height-sm": "2rem",
        "height-default": "2.25rem",
        "height-lg": "2.5rem",
        "focus-ring": "3px ring-ring/50 + border-ring",
        "icon-size": "1rem"
    },
    "status-tones": {
        "neutral": { "bg": "muted", "dot": "muted-foreground" },
        "info": { "bg": "info / 12%", "dot": "info" },
        "success": { "bg": "success / 12%", "dot": "success" },
        "warning": { "bg": "warning / 15%", "dot": "warning" },
        "danger": { "bg": "destructive / 12%", "dot": "destructive" }
    },
    "thresholds": {
        "usage-bar": { "normal": "<70% → chart-1", "warning": "70–89% → warning", "danger": "≥90% → destructive" }
    }
}
